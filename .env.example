# Copy to .env if you need to override defaults. No secrets are required: the app reads
# public Elexon data that is cached in backend/data/.

# Comma-separated browser origins allowed to call the API cross-origin.
# Only needed when the UI runs on a different origin (e.g. the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
